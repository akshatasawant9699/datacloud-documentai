# Salesforce OAuth Configuration
# Copy this file to .env and fill in your values

# Login URL (without https://)
LOGIN_URL=login.salesforce.com

# Connected App Credentials
CLIENT_ID=your-connected-app-client-id
CLIENT_SECRET=your-connected-app-client-secret

# API Version
API_VERSION=v65.0

# Token storage configuration (for local development)
TOKEN_FILE=access-token.secret

# Optional: For password-based authentication (demo script only)
# SF_USERNAME=your-salesforce-username
# SF_PASSWORD=your-salesforce-password
# SF_SECURITY_TOKEN=your-security-token
# INSTANCE_URL=https://your-instance.my.salesforce.com
