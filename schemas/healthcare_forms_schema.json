          "policy_holder_dob": {"type": "string", "description": "Policy holder date of birth"},
          "policy_holder_relationship": {"type": "string", "description": "Patient's relationship to policy holder"},
          
          "pharmacy_name": {"type": "string", "description": "Pharmacy name"},
          "pharmacy_address": {"type": "string", "description": "Pharmacy address"},
          "pharmacy_phone": {"type": "string", "description": "Pharmacy phone number"},
          "pharmacy_fax": {"type": "string", "description": "Pharmacy fax number"},
          "pharmacy_npi": {"type": "string", "description": "Pharmacy NPI"},
          "pharmacist_name": {"type": "string", "description": "Pharmacist name"},
          
          "lab_test_name": {"type": "string", "description": "Laboratory test name"},
          "lab_test_date": {"type": "string", "description": "Date of lab test"},
          "lab_result_value": {"type": "string", "description": "Lab test result value"},
          "lab_result_unit": {"type": "string", "description": "Unit of measurement"},
          "lab_reference_range": {"type": "string", "description": "Normal reference range"},
          "lab_facility": {"type": "string", "description": "Lab facility name"},
          "lab_notes": {"type": "string", "description": "Lab notes or comments"},
          
          "prior_auth_number": {"type": "string", "description": "Prior authorization number"},
          "prior_auth_status": {"type": "string", "description": "Prior auth status (Approved/Pending/Denied)"},
          "prior_auth_date": {"type": "string", "description": "Prior auth date"},
          "prior_auth_expiry": {"type": "string", "description": "Prior auth expiration date"},
          
          "program_name": {"type": "string", "description": "Patient assistance program name"},
          "program_enrollment_date": {"type": "string", "description": "Program enrollment date"},
          "program_id": {"type": "string", "description": "Program enrollment ID"},
          
          "consent_obtained": {"type": "string", "description": "Patient consent obtained (Yes/No)"},
          "consent_date": {"type": "string", "description": "Date consent was signed"},
          "hipaa_authorization": {"type": "string", "description": "HIPAA authorization signed (Yes/No)"},
          
          "notes": {"type": "string", "description": "Additional notes or comments on the form"},
          "special_instructions": {"type": "string", "description": "Special instructions or requirements"},
          "follow_up_date": {"type": "string", "description": "Follow-up appointment date"},
          "follow_up_instructions": {"type": "string", "description": "Follow-up care instructions"}
        }
      }
    },
    "extraction_summary": {
      "type": "object",
      "properties": {
        "total_forms_found": {"type": "number", "description": "Total number of forms detected"},
        "total_pages": {"type": "number", "description": "Total pages processed"},
        "form_types_found": {"type": "string", "description": "List of form types identified"},
        "total_medications": {"type": "number", "description": "Total medications found across all forms"},
        "total_patients": {"type": "number", "description": "Unique patients identified"}
      }
    }
  }
}