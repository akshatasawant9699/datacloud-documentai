<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>A simple working flow to test Document AI Apex actions.</description>
    <label>Document AI Simple Working Flow</label>
    <processType>Flow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Document_AI_Extract_Action</targetReference>
        </connector>
    </start>
    <actionCalls>
        <name>Document_AI_Extract_Action</name>
        <label>Document AI Extract Action</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <actionName>DocumentProcessor.processDocument</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>requests</name>
            <value>
                <elementReference>documentRequests</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <name>output</name>
            <assignToReference>extractedData</assignToReference>
        </outputParameters>
    </actionCalls>
    <variables>
        <name>documentRequests</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>extractedData</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
